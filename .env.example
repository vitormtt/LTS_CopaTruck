# Copy to .env and adjust. Compose injects these into both db and app;
# the same variables drive src/database/db_manager.py when running the
# Streamlit app outside Docker (see `make run-local`).
DB_USER=saru_admin
DB_PASSWORD=saru_pass_dev_only
DB_NAME=copa_truck_sim
DB_PORT=5432

# Host port for the Streamlit UI
APP_PORT=8501
